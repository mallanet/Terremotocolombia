{
  "_note": "Static PWA manifest. Icons are PNG (not SVG) for iOS/Android/crawler compatibility. name/short_name/description/lang follow config/deployment.config.json.",
  "name": "Terremoto Colombia · Mallanet.org",
  "short_name": "Terremoto Colombia",
  "description": "Reporte ciudadano en tiempo real para coordinar rescates, identificar daños y organizar ayuda humanitaria durante una emergencia en Colombia.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f8fafc",
  "theme_color": "#003893",
  "categories": ["utilities", "social", "news"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Reportar",
      "short_name": "Reportar",
      "url": "/#mapa",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Personas desaparecidas",
      "short_name": "Desaparecidas",
      "url": "/#e-directory",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Teléfonos de emergencia",
      "short_name": "Teléfonos",
      "url": "/#telefonos",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
